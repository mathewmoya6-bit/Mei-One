    fields: [["Vehicle", ["vehicle", "make_model"]], ["Plate", ["plate", "registration"]], ["Fault", ["fault", "issue", "problem"]]] },
  roadside: { name: "Roadside Assistance", icon: "🛟", color: "#0ea5e9", tip: "Park safely and put on hazard lights before you work.",
    checklist: ["Problem resolved or escalated", "Customer's vehicle starts and is safe to drive"], steps: flow("Head to customer", "I've arrived", "Start repair", "Issue resolved"),
    fields: [["Problem", ["problem", "issue", "fault", "service_needed"]], ["Vehicle", ["vehicle", "make_model"]]] },
