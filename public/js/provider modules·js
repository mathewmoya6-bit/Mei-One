};
const FALLBACK = { name: "Provider", icon: "🧰", color: "#00d68f", tip: "", checklist: [], steps: flow("Head to customer", "I've arrived", "Start job", "Complete job"), fields: [] };
const norm = (s) => String(s).toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "");
function parse(d) {
  const out = {}; if (!d) return out;
  if (typeof d === "object") { Object.entries(d).forEach(([k, v]) => (out[norm(k)] = v)); return out; }
  try { const j = JSON.parse(d); if (j && typeof j === "object") return parse(j); } catch {}
  String(d).split(/\n|\|/).forEach((p) => { const i = p.indexOf(":"); if (i > 0) out[norm(p.slice(0, i))] = p.slice(i + 1).trim(); });
  return out;
}
window.MEI_MODULES = {
