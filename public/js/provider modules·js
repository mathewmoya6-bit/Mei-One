/* MEI One provider service modules. One entry per service: flow labels, highlighted fields, checklist, tip. */
window.MEI_MODULES = (() => {
  const ORDER = ["accepted", "en_route", "arrived", "in_progress"];
  const NEXT_TO = { accepted: "en_route", en_route: "arrived", arrived: "in_progress", in_progress: "completed" };
  const mk = (o) => Object.assign({ icon: "🛠️", name: "Service", labels: [], fields: [], checklist: [], tip: "" }, o);
  const M = {
    towing: mk({ icon: "🛻", name: "Towing", labels: ["Heading to vehicle", "On scene", "Vehicle loaded", "Delivered, complete"],
      fields: ["Vehicle", "Plate", "Registration", "Make", "Issue", "Condition"],
      checklist: ["Vehicle secured and photographed", "Customer signed off at destination"], tip: "Photograph the vehicle before loading." }),
    roadside: mk({ icon: "🧰", name: "Roadside Assistance", labels: ["On my way", "On site", "Start repair", "Issue resolved"],
      fields: ["Issue", "Vehicle", "Plate", "Fault", "Fuel type"],
      checklist: ["Vehicle starts / is safe to drive", "Customer confirmed resolution"], tip: "Park safely and use hazard lights." }),
    accident_scene: mk({ icon: "🚨", name: "Accident Scene", labels: ["Dispatching", "On scene", "Scene secured", "Handed over"],
      fields: ["Vehicles involved", "Injuries", "Police", "Vehicle", "Plate"],
      checklist: ["Scene made safe", "Injuries referred to emergency services", "Incident details recorded"], tip: "Safety first. Call emergency services for any injury." }),
    rides: mk({ icon: "🚘", name: "MEI Rides", labels: ["On my way", "Arrived at pickup", "Start trip", "End trip"],
      fields: ["Passengers", "Pickup time", "Luggage"], checklist: ["Passenger dropped at destination"], tip: "Confirm the passenger name before starting." }),
    delivery: mk({ icon: "📦", name: "Delivery", labels: ["Heading to pickup", "At pickup", "Parcel picked up", "Delivered"],
      fields: ["Item", "Parcel", "Size", "Weight", "Fragile", "Recipient"],
      checklist: ["Recipient received the items", "Items match the description"], tip: "Check the items before leaving pickup." }),
    garage: mk({ icon: "🔧", name: "Garage Services", labels: ["On my way", "Vehicle received", "Start service", "Service complete"],
      fields: ["Vehicle", "Plate", "Service", "Issue", "Preferred time"],
      checklist: ["Work done as agreed", "Vehicle returned to customer"], tip: "Agree the price before starting work." }),
    valuation: mk({ icon: "📊", name: "Valuation & Inspection", labels: ["On my way", "At vehicle", "Start inspection", "Report submitted"],
      fields: ["Vehicle", "Plate", "Make", "Model", "Year", "Mileage"],
      checklist: ["All inspection points completed", "Report submitted to the customer"], tip: "Record chassis and plate details accurately." }),
    home: mk({ icon: "🏠", name: "Home Services", labels: ["On my way", "Arrived at address", "Start work", "Work complete"],
      fields: ["Job", "Category", "Preferred time", "Access"],
      checklist: ["Work completed to the customer's satisfaction", "Site left clean and tidy"], tip: "Confirm the scope and price with the customer before starting." }),
    marketplace: mk({ icon: "🛒", name: "Marketplace", labels: ["Accepted", "Ready", "Handed over", "Complete"], checklist: ["Order delivered or collected"] }),
    learn: mk({ icon: "🎓", name: "Learning & Driver Training", labels: ["Confirmed", "Arrived", "Start session", "Session complete"], checklist: ["Session completed"] }),
  };
  const fallback = mk({ labels: ["On my way", "I've arrived", "Start service", "Complete job"], checklist: ["Job completed"] });
  return {
    get(key) { return M[key] || fallback; },
    step(key, status) {
      const i = ORDER.indexOf(status); if (i < 0) return null;
      return { to: NEXT_TO[status], label: this.get(key).labels[i] || fallback.labels[i] };
    },
    highlights(key, details) {
      const want = this.get(key).fields.map((f) => f.toLowerCase());
      return String(details || "").split(/\r?\n/).map((l) => { const i = l.indexOf(":"); return i > 0 ? [l.slice(0, i).trim(), l.slice(i + 1).trim()] : null; })
        .filter((p) => p && p[1] && want.includes(p[0].toLowerCase()));
    },
  };
})();
