    fields: [["Ride type", ["vehicle_class", "ride_type", "class", "vehicle"]], ["Passengers", ["passengers", "seats"]], ["Pickup time", ["pickup_time", "scheduled_at"]]] },
  delivery: { name: "MEI Delivery", icon: "📦", color: "#f59e0b", tip: "Verify the package and recipient before handover.",
    checklist: ["Package handed to the right recipient", "Proof of delivery taken"], steps: flow("Head to pickup", "At pickup", "Picked up, on the way", "Delivered"),
