:root{--ink:#10231f;--paper:#f6f7f4;--card:#fff;--line:#dfe4de;--mute:#5d6e68;--signal:#ffc933;--green:#2f6f5e;--red:#d7263d;--r:16px;--f:'Bricolage Grotesque',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}
@media(prefers-color-scheme:dark){:root{--ink:#eef2ee;--paper:#0d1a17;--card:#14262a;--line:#27403a;--mute:#9bb0a8}.wallet{background:#1d3a33}.btn{background:var(--signal);color:#10231f}}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{font-family:var(--f);background:var(--paper);color:var(--ink);font-size:16px;line-height:1.45;-webkit-tap-highlight-color:transparent}
#app{max-width:520px;margin:0 auto;min-height:100%;padding:env(safe-area-inset-top,0) 0 calc(76px + env(safe-area-inset-bottom,0))}
.auth{padding:12vh 24px 24px}
.screen{padding:20px 18px}
h1{font-size:2rem;font-weight:800;letter-spacing:-.02em;line-height:1.1}
h2{font-size:1.25rem;font-weight:800;margin:22px 0 10px}
p.sub{color:var(--mute);margin:6px 0 18px}
.top{display:flex;justify-content:space-between;align-items:center;gap:12px}
.hello{font-size:1.5rem;font-weight:800;letter-spacing:-.01em}
.loc{color:var(--mute);font-size:.9rem}
label{display:block;font-weight:600;font-size:.9rem;margin:14px 0 6px}
input,select,textarea{width:100%;font:inherit;color:inherit;background:var(--card);border:1.5px solid var(--line);border-radius:12px;padding:13px 14px}
input:focus,select:focus,textarea:focus,button:focus-visible,a:focus-visible{outline:3px solid var(--signal);outline-offset:1px}
textarea{min-height:84px;resize:vertical}
.btn{display:block;width:100%;border:0;border-radius:12px;padding:15px;font:inherit;font-weight:800;background:var(--ink);color:var(--paper);cursor:pointer;margin-top:18px}
.btn.alt{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.btn.sos{background:var(--red);color:#fff}
.btn:disabled{opacity:.55}
.link{background:none;border:0;color:var(--green);font:inherit;font-weight:600;cursor:pointer;padding:8px 0}
.sos-bar{display:flex;align-items:center;gap:14px;width:100%;border:0;border-radius:var(--r);background:var(--red);color:#fff;padding:16px;margin:18px 0 6px;font:inherit;text-align:left;cursor:pointer}
.sos-bar b{display:block;font-size:1.1rem}
.sos-bar span.i{font-size:1.8rem}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.tile{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);padding:16px 8px;text-align:center;font:inherit;font-weight:600;font-size:.88rem;cursor:pointer;color:inherit}
.tile .e{display:block;font-size:1.8rem;margin-bottom:6px}
.tile.soon{opacity:.5}
.tile:active{background:var(--signal);border-color:var(--signal)}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:14px 0;border-bottom:1px solid var(--line)}
.row small{color:var(--mute);display:block}
.badge{font-size:.78rem;font-weight:700;background:var(--signal);color:#10231f;border-radius:99px;padding:3px 10px;white-space:nowrap}
.badge.ok{background:#bfe8d4}.badge.bad{background:#f6c4cb}
.wallet{background:var(--ink);color:var(--paper);border-radius:var(--r);padding:22px}
.wallet b{display:block;font-size:2.2rem;letter-spacing:-.02em}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1.5px solid var(--line);background:var(--card);color:inherit;border-radius:99px;padding:9px 14px;font:inherit;font-weight:600;cursor:pointer}
.chip[aria-pressed=true]{background:var(--signal);border-color:var(--signal);color:#10231f}
#app nav{position:fixed;left:0;right:0;bottom:0;background:var(--card);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0)}
#app nav div{max-width:520px;margin:0 auto;display:grid;grid-template-columns:repeat(5,1fr)}
#app nav button{background:none;border:0;padding:10px 0 9px;font:inherit;font-size:.75rem;color:var(--mute);cursor:pointer}
#app nav button .e{display:block;font-size:1.3rem}
#app nav button[aria-current=page]{color:var(--ink);font-weight:800}
#toast{position:fixed;left:50%;bottom:calc(90px + env(safe-area-inset-bottom,0));transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:11px 18px;border-radius:99px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .2s;max-width:90vw;text-align:center}
#toast.on{opacity:1}
.empty{color:var(--mute);padding:28px 0;text-align:center}
.back{margin-bottom:6px}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
.wide #app,body.wide #app{max-width:1100px}
.hd{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line);background:var(--card)}
.hd b{font-size:1.1rem;font-weight:800}
.hd button{width:auto;margin:0;padding:8px 14px}
.tabs{display:flex;gap:8px;padding:12px 18px;overflow-x:auto}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.kpi{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);padding:16px}
.kpi b{display:block;font-size:1.8rem;letter-spacing:-.02em}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:.9rem}th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
.mini{width:auto;margin:0 0 0 6px;padding:8px 12px;font-size:.85rem}
.sw{display:flex;align-items:center;gap:10px;font-weight:700}
.chk{display:flex;gap:8px;align-items:center;margin:6px 0;font-weight:400}.chk input{width:auto}
.hint{color:var(--mute);font-size:.85rem}
/* ===== Landing site (body.site) — same tokens as the apps ===== */
.site{overflow-x:hidden}
.site .container{max-width:1100px;margin:0 auto;padding:0 20px}
.site .btn{display:inline-block;width:auto;margin:0;padding:12px 20px;text-align:center;text-decoration:none;border-radius:12px;font-weight:800}
.site .btn-small{padding:9px 16px;font-size:.9rem}.site .btn-large{padding:16px 28px;font-size:1.05rem}.site .btn-block{width:100%;margin-top:16px}
.site .btn-primary{background:var(--signal);color:#10231f}
.site .btn-outline{background:transparent;color:var(--ink);border:1.5px solid var(--line)}
.site .btn-ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.site .btn-light{background:#fff;color:var(--red)}
.site-header{position:sticky;top:0;z-index:20;background:var(--paper);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0)}
.nav-container{display:flex;align-items:center;justify-content:space-between;height:64px}
.brand{display:flex;align-items:center;gap:6px;text-decoration:none;color:var(--ink);font-weight:800;letter-spacing:-.01em}
.brand-mark{background:var(--ink);color:var(--paper);border-radius:8px;padding:3px 8px}.brand-name{color:var(--green)}
.main-navigation{display:flex;align-items:center;gap:22px}.main-navigation>a{color:var(--ink);text-decoration:none;font-weight:600}
.mobile-menu-button{display:none;background:none;border:0;padding:10px;cursor:pointer}
.mobile-menu-button span{display:block;width:22px;height:2px;background:var(--ink);margin:5px 0}
.eyebrow{color:var(--green);font-weight:700;font-size:.9rem;margin-bottom:12px}
.section{padding:84px 0}.section h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:800;letter-spacing:-.02em;line-height:1.1;margin:0}
.hero-section{padding:64px 0 72px}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center}
.hero-content h1{font-size:clamp(2.4rem,6vw,4.2rem);letter-spacing:-.03em}.hero-content h1 span{display:block;color:var(--green)}
.hero-description{font-size:1.15rem;color:var(--mute);max-width:46ch;margin:18px 0 28px}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px}.hero-trust{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:26px;color:var(--mute);font-weight:600;font-size:.9rem}
.browser-window{background:var(--card);border:1.5px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:0 24px 60px -24px rgba(16,35,31,.35)}
.browser-bar{display:flex;align-items:center;gap:12px;padding:12px 14px;border-bottom:1px solid var(--line)}
.browser-dots{display:flex;gap:6px}.browser-dots span{width:10px;height:10px;border-radius:50%;background:var(--line)}
.browser-address{flex:1;background:var(--paper);border-radius:99px;padding:4px 14px;font-size:.85rem;color:var(--mute)}
.preview-content{padding:18px}.preview-header{display:flex;justify-content:space-between;align-items:center}.preview-header h3{font-size:1.2rem;margin:2px 0 0}.preview-header small{color:var(--mute)}
.preview-avatar{width:40px;height:40px;border-radius:50%;background:var(--ink);color:var(--paper);display:grid;place-items:center;font-weight:800}
.preview-services{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:16px 0}
.preview-services button{background:var(--paper);border:1.5px solid var(--line);border-radius:14px;padding:12px 4px;cursor:pointer;color:inherit;font:inherit}
.preview-services span{display:block;font-size:1.5rem}.preview-services strong{font-size:.82rem}
.preview-emergency{display:flex;align-items:center;gap:10px;background:var(--red);color:#fff;border-radius:14px;padding:12px}
.preview-emergency-icon{font-size:1.5rem}.preview-emergency-text{flex:1;font-size:.8rem}.preview-emergency-text strong{display:block;font-size:.9rem}
.preview-emergency button{background:#fff;color:var(--red);border:0;border-radius:99px;padding:8px 14px;font:inherit;font-weight:800;cursor:pointer}
.platform-stats{background:var(--ink);color:var(--paper);padding:34px 0}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.stat-item strong{display:block;font-size:2rem;letter-spacing:-.02em}.stat-item span{opacity:.75}
.section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;margin-bottom:36px}.section-heading p{max-width:40ch;color:var(--mute)}.section-heading.centered{justify-content:center;text-align:center}
.services-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px}
.service-card{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);padding:22px;display:flex;flex-direction:column;gap:8px}
.service-card h3{font-size:1.15rem;margin:0}.service-card p{color:var(--mute);flex:1}.service-icon{font-size:2rem}
.service-emergency{border-color:var(--red)}
.service-link{background:none;border:0;padding:6px 0;font:inherit;font-weight:800;color:var(--green);cursor:pointer;text-align:left}
.how-section{background:var(--card)}
.steps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.step-card{border:1.5px solid var(--line);border-radius:var(--r);padding:22px;background:var(--paper)}
.step-number{font-weight:800;color:var(--green)}.step-icon{font-size:1.8rem;margin:8px 0}.step-card h3{font-size:1.1rem;margin:0 0 6px}.step-card p{color:var(--mute)}
.emergency-section{background:var(--red);color:#fff;padding:56px 0}.emergency-section .eyebrow{color:#fff;opacity:.85}
.emergency-content{display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap}.emergency-content p{max-width:52ch;margin-top:10px;opacity:.92}
.partners-grid,.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.partners-content p{margin:14px 0 22px;color:var(--mute)}.about-grid p{color:var(--mute);margin-bottom:14px}
.partner-types{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.partner-card{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);padding:18px}.partner-card span{font-size:1.8rem;display:block}.partner-card small{display:block;color:var(--mute)}
.site-footer{background:var(--ink);color:var(--paper);padding:48px 0 24px}.site-footer .brand,.site-footer .brand-name{color:var(--paper)}.site-footer .brand-mark{background:var(--signal);color:#10231f}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:32px}.footer-brand p{margin-top:10px;opacity:.75}
.footer-column{display:flex;flex-direction:column;align-items:flex-start;gap:8px}.footer-column h4{margin-bottom:4px}
.footer-column a,.footer-column button{color:var(--paper);opacity:.8;background:none;border:0;padding:0;font:inherit;text-decoration:none;cursor:pointer;text-align:left}
.footer-bottom{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:32px;padding-top:18px;border-top:1px solid rgba(255,255,255,.18);opacity:.7;font-size:.9rem}
.modal{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;padding:16px}.modal.open{display:flex}
.modal-backdrop{position:absolute;inset:0;background:rgba(8,18,16,.6)}
.modal-dialog{position:relative;background:var(--card);color:var(--ink);border-radius:20px;padding:28px 24px;width:100%;max-width:420px;max-height:90vh;overflow:auto}
.modal-dialog h2{font-size:1.5rem;margin:0 0 6px}.modal-dialog p{color:var(--mute);margin-top:6px}
.modal-close{position:absolute;top:10px;right:12px;background:none;border:0;font-size:1.8rem;line-height:1;color:var(--mute);cursor:pointer}
.form-msg{min-height:1.2em;font-size:.9rem;margin-top:10px}
@media(max-width:820px){
.mobile-menu-button{display:block}
.main-navigation{display:none;position:absolute;top:64px;left:0;right:0;background:var(--paper);border-bottom:1px solid var(--line);flex-direction:column;align-items:stretch;padding:16px 20px;gap:14px}
.main-navigation.open{display:flex}
.hero-grid,.partners-grid,.about-grid,.footer-grid{grid-template-columns:1fr}
.stats-grid{grid-template-columns:repeat(2,1fr)}.section-heading{flex-direction:column;align-items:flex-start}.section{padding:56px 0}}
